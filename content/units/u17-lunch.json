        "npc": { "en": "Amy, have you eaten?", "zh": "Amy，吃了吗？" },
        "replies": [
          { "en": "Not yet. I'm hungry.", "zh": "还没有。我饿了。", "next": "n2" },
          { "en": "Not yet.", "zh": "还没有。", "next": "n2" }
        ]
      },
      {
        "id": "n2",
        "npc": { "en": "Do you want to have lunch together?", "zh": "要一起吃午饭吗？" },
        "replies": [
          { "en": "Sure! What do you want to eat?", "zh": "好啊！你想吃什么？", "next": "n3" },
          { "en": "Sorry, I'm busy today. Maybe next time.", "zh": "不好意思，我今天很忙。下次吧。", "next": "later" }
        ]
      },
      {
        "id": "n3",
        "npc": { "en": "Chicken rice? There's a good stall downstairs.", "zh": "鸡饭怎么样？楼下有一家很好吃。" },
