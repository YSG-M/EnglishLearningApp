          {"en": "She is coming now. Please wait here.", "zh": "她马上就来，请在这里等。", "next": "end"}
        ]
      },
      {
        "id": "end",
        "npc": {"en": "Oh, there she is. Thank you!", "zh": "哦，她来了。谢谢！"},
        "replies": []
      }
    ]
  },
  "task": "今天上班时，对来的家长说一句 Hi, how can I help you? 或 Please take a seat."
}
