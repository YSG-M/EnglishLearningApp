          {"en": "Hi, how can I help you?", "zh": "你好，有什么可以帮你？", "next": "n2"}
        ]
      },
      {
        "id": "n2",
        "npc": {"en": "I'm here to pick up my daughter.", "zh": "我来接我女儿。"},
