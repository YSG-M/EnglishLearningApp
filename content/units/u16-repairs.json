  "phonics": "p14",
  "dialogue": {
    "title": "打电话叫空调师傅",
    "setting": "家里的空调不冷了，你打电话给空调维修公司。",
    "npcName": "Uncle Lim",
    "npcVoice": "bm_lewis",
    "start": "n1",
    "nodes": [
      {
        "id": "n1",
        "npc": { "en": "Hello, aircon service. How can I help?", "zh": "你好，空调维修。有什么可以帮你？" },
        "replies": [{ "en": "Hi, my aircon is not working.", "zh": "你好，我的空调坏了。", "next": "n2" }]
      },
      {
        "id": "n2",
        "npc": { "en": "OK. What's your address?", "zh": "好的。你的地址是？" },
        "replies": [{ "en": "I live in Block 123.", "zh": "我住在 123 座。", "next": "n3" }]
      },
      {
        "id": "n3",
        "npc": { "en": "I can come on Friday afternoon.", "zh": "我星期五下午可以来。" },
        "replies": [
          { "en": "Can you come tomorrow morning?", "zh": "你明天早上能来吗？", "next": "n4" },
          { "en": "OK, Friday afternoon is fine.", "zh": "好的，星期五下午可以。", "next": "n5" }
        ]
      },
      {
        "id": "n4",
        "npc": { "en": "Tomorrow morning, ten o'clock. Can?", "zh": "明天早上十点，可以吗？" },
        "replies": [{ "en": "Yes, thank you.", "zh": "可以，谢谢。", "next": "n5" }]
      },
      {
        "id": "n5",
        "npc": { "en": "Checking is fifty dollars first.", "zh": "先检查要五十块。" },
        "replies": [
          { "en": "OK. Please call me before you come.", "zh": "好的。来之前请给我打电话。", "next": "end" },
          { "en": "How much will it cost?", "zh": "（修好）一共要多少钱？", "next": "end" }
        ]
      },
      {
        "id": "end",
        "npc": { "en": "I check first, then I tell you. No problem. Bye!", "zh": "我先检查，再告诉你。没问题。拜拜！" },
        "replies": []
      }
    ]
  },
  "task": "看看家里有什么东西坏了或者有点旧，用英语说一句：My ___ is not working."
}
