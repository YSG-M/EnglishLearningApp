  "phonics": "p06",
  "dialogue": {
    "title": "Grab 司机打电话找你",
    "setting": "你叫了 Grab，司机打电话来问你在哪里。",
    "npcName": "Grab driver",
    "npcVoice": "am_michael",
    "start": "n1",
    "nodes": [
      {
        "id": "n1",
        "npc": { "en": "Hello, I'm your Grab driver. Where are you now?", "zh": "你好，我是你的 Grab 司机。你现在在哪里？" },
        "replies": [
          { "en": "I'm at the lobby.", "zh": "我在大堂。", "next": "n2" },
          { "en": "Sorry, can you say that again?", "zh": "不好意思，可以再说一遍吗？", "next": "n1b" }
        ]
      },
      {
        "id": "n1b",
        "npc": { "en": "Sure. Where. Are. You?", "zh": "好的。你——在——哪里？" },
        "replies": [{ "en": "I'm at the lobby.", "zh": "我在大堂。", "next": "n2" }]
      },
      {
        "id": "n2",
        "npc": { "en": "Block 123, right?", "zh": "123 座，对吗？" },
        "replies": [{ "en": "Yes, block 123.", "zh": "对，123 座。", "next": "n3" }]
      },
      {
        "id": "n3",
        "npc": { "en": "Okay, I'm here already. Silver car.", "zh": "好的，我已经到了。银色的车。" },
        "replies": [{ "en": "Okay, I'm coming.", "zh": "好的，我马上来。", "next": "end" }]
      },
      {
        "id": "end",
        "npc": { "en": "No problem. See you.", "zh": "没问题，待会见。" },
        "replies": []
      }
    ]
  },
  "task": "今天坐 MRT、巴士或 Grab 时，用英语说一遍你要去哪里：How do I get to ...?"
