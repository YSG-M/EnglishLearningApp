  "goal": "能问路、问坐哪路巴士，打 Grab 时能告诉司机你在哪里。",
  "chunks": [
    { "id": "u08.c01", "en": "Excuse me, where is the MRT station?", "zh": "请问，地铁站在哪里？", "note": "Excuse me 是向陌生人开口时的礼貌开头。MRT 就是新加坡的地铁。" },
    { "id": "u08.c02", "en": "How do I get to Orchard?", "zh": "去乌节路怎么走？", "note": "把 Orchard 换成你要去的地方。" },
    { "id": "u08.c03", "en": "Which bus should I take?", "zh": "我应该坐哪路巴士？" },
    { "id": "u08.c04", "en": "Is this the right way?", "zh": "这个方向对吗？" },
    { "id": "u08.c05", "en": "Is it far?", "zh": "远吗？" },
    { "id": "u08.c06", "en": "How long does it take?", "zh": "要多久？" },
    { "id": "u08.c07", "en": "I'm at the lobby.", "zh": "我在大堂。", "note": "打 Grab 时告诉司机你在哪里。组屋楼下也可以说 void deck。" },
    { "id": "u08.c08", "en": "Please stop here.", "zh": "请在这里停。" },
    { "id": "u08.c09", "en": "Okay, I'm coming.", "zh": "好的，我马上来。" }
  ],
  "words": ["excuse", "mrt", "station", "bus", "right", "way", "far", "long", "lobby", "stop"],
