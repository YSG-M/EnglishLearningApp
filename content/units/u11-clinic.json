  "phonics": "p09",
  "dialogue": {
    "title": "在诊所看医生",
    "setting": "你感冒了，去家附近的诊所看医生。",
    "npcName": "Doctor",
    "npcVoice": "bm_george",
    "start": "n1",
    "nodes": [
      {
        "id": "n1",
        "npc": { "en": "Hello, what's the problem today?", "zh": "你好，今天哪里不舒服？" },
        "replies": [
          { "en": "I have a fever.", "zh": "我发烧了。", "next": "n2" },
          { "en": "I have a sore throat.", "zh": "我喉咙痛。", "next": "n2" }
        ]
      },
      {
        "id": "n2",
        "npc": { "en": "I see. Since when?", "zh": "明白了。从什么时候开始的？" },
        "replies": [{ "en": "Since yesterday.", "zh": "从昨天开始。", "next": "n3" }]
      },
      {
        "id": "n3",
        "npc": { "en": "Any cough?", "zh": "有咳嗽吗？" },
        "replies": [
          { "en": "Yes, I have a cough.", "zh": "有，我咳嗽。", "next": "n4" },
          { "en": "No.", "zh": "没有。", "next": "n4" }
        ]
      },
      {
        "id": "n4",
        "npc": { "en": "Okay, I'll give you some medicine. Take it three times a day.", "zh": "好，我给你开一些药，一天吃三次。" },
        "replies": [
          { "en": "Before or after food?", "zh": "饭前还是饭后吃？", "next": "n5" },
          { "en": "Sorry, can you say that again?", "zh": "不好意思，可以再说一遍吗？", "next": "n4" }
        ]
      },
      {
        "id": "n5",
        "npc": { "en": "After food. Do you need an MC?", "zh": "饭后吃。你需要病假单吗？" },
        "replies": [
          { "en": "Yes, I need an MC, please.", "zh": "需要，请给我病假单。", "next": "end" },
          { "en": "No, thank you.", "zh": "不用，谢谢。", "next": "end" }
        ]
      },
      {
        "id": "end",
        "npc": { "en": "Okay. Rest well and drink more water.", "zh": "好的。好好休息，多喝水。" },
        "replies": []
      }
    ]
  },
  "task": "把 I have a fever. 和 I have a cough. 各读三遍，再把它们记在手机备忘录里，下次去诊所就用得上。"
}
