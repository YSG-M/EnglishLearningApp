        { "en": "Yesterday I ...", "zh": "昨天你做了什么" },
        { "en": "In the morning, I ...", "zh": "早上做了什么" },
        { "en": "At work, I ...", "zh": "上班时做了什么" },
        { "en": "After work, I ...", "zh": "下班后做了什么" }
      ],
      "maxSeconds": 60
    }
