{
  "id": "p03",
  "title": "短元音 a：cat、bag 里的 a",
  "rule": "单个 a 夹在两个辅音中间（像 c-a-t），通常读短音 /æ/。这个音介于拼音\"啊\"和\"哎\"之间，中文里没有完全一样的。很多中国人会读成\"诶\"（bed 的音），那样 bad 就变成 bed 了。",
  "mouth": "嘴巴张得很大，嘴角往两边拉，像要说\"哎\"但下巴再往下掉一点。",
  "examples": [
    { "en": "cat", "zh": "猫" },
    { "en": "bag", "zh": "包" },
    { "en": "man", "zh": "男人" },
    { "en": "dad", "zh": "爸爸" },
    { "en": "class", "zh": "班；课" },
    { "en": "thanks", "zh": "谢谢" },
    { "en": "black", "zh": "黑色" }
  ],
  "pairs": [
    { "id": "p03.m01", "a": { "en": "bad", "zh": "坏的" }, "b": { "en": "bed", "zh": "床" } },
    { "id": "p03.m02", "a": { "en": "man", "zh": "男人" }, "b": { "en": "men", "zh": "男人们" } },
    { "id": "p03.m03", "a": { "en": "sad", "zh": "伤心的" }, "b": { "en": "said", "zh": "说了" } },
    { "id": "p03.m04", "a": { "en": "pan", "zh": "平底锅" }, "b": { "en": "pen", "zh": "笔" } }
  ]
}
