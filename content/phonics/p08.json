{
  "id": "p08",
  "title": "不发音的 e（一）：a_e 读字母 A 本身的音",
  "rule": "单词结尾是\"辅音 + e\"时，最后的 e 不发音，但它会让前面的元音读成字母本身的名字。a_e 就读字母 A 的音 /eɪ/，像拼音\"诶伊\"(ei)。比较：cap（短 a）→ cape（长 a）。",
  "examples": [
    { "en": "name", "zh": "名字" },
    { "en": "cake", "zh": "蛋糕" },
    { "en": "late", "zh": "迟到的" },
    { "en": "make", "zh": "做" },
    { "en": "same", "zh": "一样的" },
    { "en": "take", "zh": "拿；带" },
    { "en": "date", "zh": "日期" }
  ],
  "pairs": [
    { "id": "p08.m01", "a": { "en": "cap", "zh": "帽子" }, "b": { "en": "cape", "zh": "披风" } },
    { "id": "p08.m02", "a": { "en": "mad", "zh": "生气的" }, "b": { "en": "made", "zh": "做了" } },
    { "id": "p08.m03", "a": { "en": "hat", "zh": "帽子" }, "b": { "en": "hate", "zh": "讨厌" } },
    { "id": "p08.m04", "a": { "en": "plan", "zh": "计划" }, "b": { "en": "plane", "zh": "飞机" } }
  ]
}
