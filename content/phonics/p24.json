{
  "id": "p24",
  "title": "重音：每个词有一个\"大声\"的部分",
  "rule": "中文每个字都有声调，英语的长单词则有一个重音：那个音节读得更响、更长、音调更高，其他音节轻轻带过。重音放错，别人就很难听懂，比放错一个音还严重。跟读时，注意听哪一部分最响。",
  "examples": [
    { "en": "teacher", "zh": "老师（重音在 TEA）" },
    { "en": "tomorrow", "zh": "明天（重音在 MOR）" },
    { "en": "afternoon", "zh": "下午（重音在 NOON）" },
    { "en": "computer", "zh": "电脑（重音在 PU）" },
    { "en": "photo", "zh": "照片（重音在 PHO）" },
    { "en": "hotel", "zh": "酒店（重音在 TEL）" },
    { "en": "banana", "zh": "香蕉（重音在 NA）" }
  ],
  "pairs": []
}
