{
  "id": "p05",
  "title": "短元音 i：sit、big 里的 i",
  "rule": "单个 i 夹在辅音中间（像 s-i-t），读短音 /ɪ/。它不是拼音\"衣\"，而是更短、更放松的音，介于\"衣\"和\"诶\"之间。读成长长的\"衣\"，sit 就变成 seat 了。",
  "mouth": "嘴巴放松，比说\"衣\"时张得稍大一点，舌头放低一点，发音要短。",
  "examples": [
    { "en": "sit", "zh": "坐" },
    { "en": "big", "zh": "大的" },
    { "en": "six", "zh": "六" },
    { "en": "fish", "zh": "鱼" },
    { "en": "milk", "zh": "牛奶" },
    { "en": "this", "zh": "这个" },
    { "en": "sick", "zh": "生病的" }
  ],
  "pairs": [
    { "id": "p05.m01", "a": { "en": "sit", "zh": "坐" }, "b": { "en": "set", "zh": "一套" } },
    { "id": "p05.m02", "a": { "en": "big", "zh": "大的" }, "b": { "en": "bag", "zh": "包" } },
    { "id": "p05.m03", "a": { "en": "pin", "zh": "别针" }, "b": { "en": "pen", "zh": "笔" } },
    { "id": "p05.m04", "a": { "en": "bit", "zh": "一点点" }, "b": { "en": "bet", "zh": "打赌" } }
  ]
}
