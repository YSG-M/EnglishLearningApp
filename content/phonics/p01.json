{
  "id": "p01",
  "title": "和拼音一样的辅音：b p m f d t n l",
  "rule": "英语字母 b、p、m、f、d、t、n、l 的发音，和拼音的声母基本一样，直接用你熟悉的拼音就行。唯一要注意：拼音声母后面总带一个元音（bō、pō、mō），英语里这些音单独出现时不要加元音，比如 bed 的 d 就是轻轻一收，不是\"德\"。",
  "examples": [
    { "en": "bus", "zh": "公交车" },
    { "en": "pen", "zh": "笔" },
    { "en": "man", "zh": "男人" },
    { "en": "fun", "zh": "好玩" },
    { "en": "dad", "zh": "爸爸" },
    { "en": "ten", "zh": "十" },
    { "en": "name", "zh": "名字" },
    { "en": "lunch", "zh": "午饭" }
  ],
  "pairs": [
