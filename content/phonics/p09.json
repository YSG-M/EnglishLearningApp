{
  "id": "p09",
  "title": "不发音的 e（二）：i_e、o_e、u_e",
  "rule": "和 a_e 一样，结尾的 e 不发音，前面的元音读字母本身的名字：i_e 读 /aɪ/（像\"爱\"），o_e 读 /əʊ/（像\"欧\"），u_e 读 /juː/（像\"优\"）。比较：kit → kite，not → note。",
  "examples": [
    { "en": "time", "zh": "时间" },
    { "en": "five", "zh": "五" },
    { "en": "nice", "zh": "好的" },
    { "en": "home", "zh": "家" },
    { "en": "phone", "zh": "电话" },
    { "en": "note", "zh": "便条" },
    { "en": "cute", "zh": "可爱的" }
  ],
  "pairs": [
    { "id": "p09.m01", "a": { "en": "kit", "zh": "工具包" }, "b": { "en": "kite", "zh": "风筝" } },
    { "id": "p09.m02", "a": { "en": "fin", "zh": "鱼鳍" }, "b": { "en": "fine", "zh": "好的" } },
    { "id": "p09.m03", "a": { "en": "not", "zh": "不" }, "b": { "en": "note", "zh": "便条" } },
    { "id": "p09.m04", "a": { "en": "hop", "zh": "跳" }, "b": { "en": "hope", "zh": "希望" } },
    { "id": "p09.m05", "a": { "en": "cub", "zh": "幼崽" }, "b": { "en": "cube", "zh": "立方体" } }
  ]
}
